        }
        lines {
          text: "  const assets = await fetchAssets();"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const index = assets.findIndex(a => a.ticker.toUpperCase() === asset.ticker.toUpperCase());"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  if (index !== -1) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    assets[index] = { ...assets[index], ...localAsset };"
