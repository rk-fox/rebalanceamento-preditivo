        lines {
          text: "export async function saveAsset(asset: Omit<Asset, \'livePrice\' | \'currentValue\' | \'variationPercent\'>): Promise<void> {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const localAsset = {"
