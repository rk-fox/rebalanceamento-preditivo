        }
        lines {
          text: "    window.addEventListener(\'storage\', handleStorageChange);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    return () => window.removeEventListener(\'storage\', handleStorageChange);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
