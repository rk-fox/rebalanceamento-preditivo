    instruction: "Replace single-view layout with responsive multi-screen layout (sidebar + bottom navbar)"
    replacement_infos {
      original_chunk {
        target_content: "  return (\n    <div id=\"app-root\" className=\"min-h-screen bg-zinc-950 text-zinc-300 flex flex-col font-sans\">\n      \n      {/* Premium Strategy Header */}\n      <Header\n        assets={assets}\n        allocations={allocations}\n        usdToBrlRate={usdToBrlRate}\n      />\n\n      {/* Database Connection Status Banner */}\n      <div className=\"max-w-7xl w-full mx-auto px-4 sm:px-6 md:px-8 mt-4\">\n        <div className={`p-4 rounded-xl border flex flex-col md:flex-row md:items-start justify-between gap-4 text-xs ${\n          user \n            ? \'bg-blue-950/10 border-blue-800/20 text-blue-400\' \n            : \'bg-amber-950/10 border-amber-800/20 text-amber-400\'\n        }`}>\n          {/* Left: DB Status info */}\n          <div className=\"flex items-start gap-2.5 flex-1\">\n            <Cloud className=\"w-4 h-4 shrink-0 mt-0.5\" />\n            <div className=\"flex-1\">\n              <div className=\"flex items-center gap-3\">\n                <span className=\"font-semibold block text-zinc-200\">\n                  {user ? \'Conectado ao Google Drive\' : \'Modo de Armazenamento Local (Offline-first)\'}\n                </span>\n                {user ? (\n                  <button onClick={handleLogout} className=\"flex items-center gap-1 px-2 py-1 bg-zinc-900 border border-zinc-800 rounded-md text-[10px] hover:bg-zinc-800 transition-colors\">\n                    <LogOut className=\"w-3 h-3\" /> Desconectar\n                  </button>\n                ) : (\n                  <button onClick={handleLogin} disabled={isLoggingIn} className=\"flex items-center gap-1.5 px-3 py-1 bg-white text-black font-medium rounded-md hover:bg-zinc-200 transition-colors\">\n                    {isLoggingIn ? \'Conectando...\' : \'Conectar com Google\'}\n                  </button>\n                )}\n              </div>\n              <p className=\"text-[10px] text-zinc-500 mt-1.5 leading-relaxed max-w-lg\">\n                {user \n                  ? `Logado como ${user.email}. Voc\303\252 pode fazer backup ou restaurar seus dados a qualquer momento.` \n                  : \'Para ativar o backup em nuvem, fa\303\247a login com sua conta Google.\'}\n              </p>\n\n              {/* Sync Status Overlay */}\n              {syncStatus.status !== \'idle\' && (\n                <div className={`mt-2.5 text-[10px] flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg border w-fit ${\n                  syncStatus.status === \'syncing\' ? \'bg-zinc-900/60 border-zinc-800/60 text-zinc-400\' :\n                  syncStatus.status === \'success\' ? \'bg-emerald-950/60 border-emerald-900/40 text-emerald-300\' :\n                  \'bg-red-950/60 border-red-900/40 text-red-300\'\n                }`}>\n                  <div className={`w-1.5 h-1.5 rounded-full ${\n                    syncStatus.status === \'syncing\' ? \'bg-zinc-400 animate-pulse\' :\n                    syncStatus.status === \'success\' ? \'bg-emerald-400 animate-pulse\' :\n                    \'bg-red-400 animate-pulse\'\n                  }`} />\n                  <span className=\"font-mono\">\n                    {syncStatus.status === \'syncing\' && \'Sincronizando...\'}\n                    {syncStatus.status === \'success\' && (syncStatus.message || \'Sincronizado!\')}\n                    {syncStatus.status === \'error\' && (syncStatus.message || \'Erro de sincroniza\303\247\303\243o.\')}\n                  </span>\n                </div>\n              )}\n            </div>\n          </div>\n          \n          {user && (\n            <div className=\"flex flex-row items-center gap-2\">\n              <button onClick={handleSyncToDrive} className=\"px-3 py-1.5 bg-blue-900/40 text-blue-200 border border-blue-800/50 rounded-lg hover:bg-blue-900/60 transition-colors font-medium\">\n                Fazer Backup\n              </button>\n              <button onClick={handleSyncFromDrive} className=\"px-3 py-1.5 bg-zinc-900 text-zinc-300 border border-zinc-800 rounded-lg hover:bg-zinc-800 transition-colors font-medium\">\n                Restaurar\n              </button>\n            </div>\n          )}\n\n      {/* Right: Market Prices updater */}\n          <div className=\"flex flex-col sm:flex-row items-stretch sm:items-center gap-3 shrink-0 border-t border-zinc-900 md:border-t-0 pt-3 md:pt-0\">\n            <div className=\"text-right hidden md:block\">\n              <span className=\"text-[10px] text-zinc-400 font-medium block\">Pre\303\247os de Mercado</span>\n              <span className=\"text-[9px] text-zinc-500 block font-mono font-bold uppercase\">Cota\303\247\303\265es Online</span>\n            </div>\n            <button\n              onClick={handleRefreshQuotes}\n              disabled={isLoadingQuotes || assets.length === 0}\n              className=\"bg-zinc-900/80 hover:bg-zinc-800 disabled:opacity-40 text-zinc-200 border border-zinc-800 rounded-lg px-3.5 py-2 flex items-center justify-center gap-2 transition-all font-semibold cursor-pointer text-xs\"\n            >\n              <RefreshCw className={`w-3.5 h-3.5 ${isLoadingQuotes ? \'animate-spin text-indigo-400\' : \'\'}`} />\n              Atualizar Cota\303\247\303\265es\n            </button>\n          </div>\n        </div>\n      </div>\n\n      {isLoading ? (\n        <div className=\"flex-1 flex flex-col items-center justify-center py-20 text-zinc-500 gap-2\">\n          <RefreshCw className=\"w-8 h-8 animate-spin text-indigo-500\" />\n          <p className=\"text-xs font-mono\">Initializing portfolio database...</p>\n        </div>\n      ) : (\n        /* Main Workspace */\n        <main className=\"flex-1 max-w-7xl w-full mx-auto p-4 sm:p-6 md:p-8 grid grid-cols-1 lg:grid-cols-12 gap-8\">\n          \n          {/* Visual Analysis Block (Full-Width) */}\n          <div className=\"lg:col-span-12\">\n            <PortfolioCharts\n              assets={assets}\n              allocations={allocations}\n              usdToBrlRate={usdToBrlRate}\n              rebalanceResult={rebalanceResult}\n            />\n          </div>\n          \n          {/* Left Side: Parameters, Configurations, and Importers (Col Span 5) */}\n          <div className=\"lg:col-span-5 space-y-6\">\n            \n            {/* Settings Panel (Gear) */}\n            <SettingsPanel\n              allocations={allocations}\n              onUpdateAllocations={handleUpdateAllocations}\n              usdToBrlRate={usdToBrlRate}\n              onUpdateUsdRate={handleUpdateUsdRate}\n              availableCategories={availableCategories}\n            />\n\n            {/* Broker Text Importer */}\n            <DataImporter\n              onImportAssets={handleImportAssets}\n              usdToBrlRate={usdToBrlRate}\n            />\n\n            {/* Demo Reset Utility card */}\n            <div className=\"bg-zinc-900/20 border border-zinc-800/60 p-4 rounded-xl flex items-center justify-between text-xs\">\n              <div>\n                <span className=\"font-semibold text-zinc-300 block\">Demonstration Mode</span>\n                <span className=\"text-[10px] text-zinc-500\">Restore default active and quarantined holdings for testing</span>\n              </div>\n              {confirmReset ? (\n                <div className=\"flex items-center gap-1.5 shrink-0\">\n                  <button\n                    onClick={() => {\n                      handleResetDemoData();\n                      setConfirmReset(false);\n                    }}\n                    className=\"bg-amber-600 hover:bg-amber-500 text-white border border-amber-500 px-2.5 py-1.5 rounded-lg flex items-center gap-1 transition-all font-medium text-[11px] cursor-pointer\"\n                  >\n                    Confirmar?\n                  </button>\n                  <button\n                    onClick={() => setConfirmReset(false)}\n                    className=\"bg-zinc-900 hover:bg-zinc-800 text-zinc-400 hover:text-zinc-200 border border-zinc-800 px-2.5 py-1.5 rounded-lg transition-all font-medium text-[11px] cursor-pointer\"\n                  >\n                    Cancelar\n                  </button>\n                </div>\n              ) : (\n                <button\n                  onClick={() => setConfirmReset(true)}\n                  className=\"bg-zinc-900 hover:bg-zinc-800 text-zinc-400 hover:text-zinc-200 border border-zinc-800 px-3 py-1.5 rounded-lg flex items-center gap-1.5 transition-all font-medium cursor-pointer\"\n                >\n                  <RotateCcw className=\"w-3.5 h-3.5\" />\n                  Reset Data\n                </button>\n              )}\n            </div>\n\n          </div>\n\n          {/* Right Side: Rebalancing Output and Active Portfolio List (Col Span 7) */}\n          <div className=\"lg:col-span-7 space-y-6\">\n            \n            {/* Rebalancing Math Engine */}\n            <RebalanceEngine\n              assets={assets}\n              allocations={allocations}\n              onCalculationTrigger={setRebalanceResult}\n              rebalanceResult={rebalanceResult}\n              usdToBrlRate={usdToBrlRate}\n            />\n\n            {/* Active Inventory with Quarantine Toggles */}\n            <AssetList\n              assets={assets}\n              onToggleQuarantine={handleToggleQuarantine}\n              onUpdateScore={handleUpdateScore}\n              onAddAsset={handleAddAsset}\n              onDeleteAsset={handleDeleteAsset}\n              categories={allocations.map(a => a.category)}\n              usdToBrlRate={usdToBrlRate}\n              isLoadingQuotes={isLoadingQuotes}\n            />\n\n          </div>\n\n        </main>\n      )}\n\n      {/* Footer */}\n      <footer className=\"bg-zinc-950 border-t border-zinc-900 py-6 text-center text-[10px] text-zinc-500 font-mono\">\n        PREDICTIVE REBALANCING ENGINE &bull; POWERED BY YAHOO FINANCE CODES &bull; BUY & HOLD INTENT\n      </footer>\n\n    </div>\n  );\n}"
        replacement_content: "  return (\n    <div id=\"app-root\" className=\"min-h-screen bg-zinc-950 text-zinc-300 flex flex-col lg:flex-row font-sans\">\n      \n      {/* 1. Menu Lateral para Telas Grandes (Sidebar) */}\n      <aside id=\"sidebar-nav\" className=\"hidden lg:flex flex-col w-64 bg-zinc-950 border-r border-zinc-900 h-screen sticky top-0 p-6 z-40 shrink-0 justify-between\">\n        <div className=\"space-y-8\">\n          {/* Branding */}\n          <div className=\"flex items-center gap-2.5\">\n            <div className=\"bg-indigo-600/10 border border-indigo-500/20 p-2 rounded-xl\">\n              <Landmark className=\"w-5 h-5 text-indigo-400\" />\n            </div>\n            <div>\n              <h1 className=\"text-sm font-bold text-zinc-100 tracking-tight font-sans\">\n                Predictive Rebalancing\n              </h1>\n              <span className=\"text-[9px] text-zinc-500 font-mono block uppercase\">Buy & Hold strategy</span>\n            </div>\n          </div>\n\n          {/* Navigation Links */}\n          <nav className=\"space-y-1.5\">\n            <button\n              onClick={() => setActiveTab(\'home\')}\n              className={`w-full flex items-center gap-3 px-3 py-2.5 text-xs font-semibold rounded-lg transition-all cursor-pointer ${\n                activeTab === \'home\'\n                  ? \'bg-indigo-600 text-white shadow-lg\'\n                  : \'text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900/40\'\n              }`}\n            >\n              <LayoutDashboard className=\"w-4 h-4\" />\n              <span>In\303\255cio</span>\n            </button>\n            <button\n              onClick={() => setActiveTab(\'rebalance\')}\n              className={`w-full flex items-center gap-3 px-3 py-2.5 text-xs font-semibold rounded-lg transition-all cursor-pointer ${\n                activeTab === \'rebalance\'\n                  ? \'bg-indigo-600 text-white shadow-lg\'\n                  : \'text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900/40\'\n              }`}\n            >\n              <Scale className=\"w-4 h-4\" />\n              <span>Sugest\303\243o de Compra</span>\n            </button>\n            <button\n              onClick={() => setActiveTab(\'contributions\')}\n              className={`w-full flex items-center gap-3 px-3 py-2.5 text-xs font-semibold rounded-lg transition-all cursor-pointer ${\n                activeTab === \'contributions\'\n                  ? \'bg-indigo-600 text-white shadow-lg\'\n                  : \'text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900/40\'\n              }`}\n            >\n              <Coins className=\"w-4 h-4\" />\n              <span>Lan\303\247ar Aportes</span>\n            </button>\n            <button\n              onClick={() => setActiveTab(\'portfolio\')}\n              className={`w-full flex items-center gap-3 px-3 py-2.5 text-xs font-semibold rounded-lg transition-all cursor-pointer ${\n                activeTab === \'portfolio\'\n                  ? \'bg-indigo-600 text-white shadow-lg\'\n                  : \'text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900/40\'\n              }`}\n            >\n              <Briefcase className=\"w-4 h-4\" />\n              <span>Minha Carteira</span>\n            </button>\n            <button\n              onClick={() => setActiveTab(\'settings\')}\n              className={`w-full flex items-center gap-3 px-3 py-2.5 text-xs font-semibold rounded-lg transition-all cursor-pointer ${\n                activeTab === \'settings\'\n                  ? \'bg-indigo-600 text-white shadow-lg\'\n                  : \'text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900/40\'\n              }`}\n            >\n              <Settings className=\"w-4 h-4\" />\n              <span>Configura\303\247\303\265es</span>\n            </button>\n          </nav>\n        </div>\n\n        {/* Sync / Storage info summary */}\n        <div className=\"pt-4 border-t border-zinc-900 space-y-3\">\n          <div className={`p-3 rounded-xl border text-[10px] ${\n            user \n              ? \'bg-blue-950/10 border-blue-800/10 text-blue-400\' \n              : \'bg-amber-950/10 border-amber-800/10 text-amber-400\'\n          }`}>\n            <span className=\"font-semibold block text-zinc-300\">\n              {user ? \'Backup em Nuvem\' : \'Armazenamento Local\'}\n            </span>\n            <span className=\"text-[9px] text-zinc-500 block mt-1 truncate\">\n              {user ? user.email : \'Salvo apenas no navegador\'}\n            </span>\n          </div>\n          <div className=\"text-[9px] text-zinc-600 font-mono text-center\">\n            PREDICTIVE ENGINE v1.2\n          </div>\n        </div>\n      </aside>\n\n      {/* 2. Barra de Navega\303\247\303\243o Inferior para Celular (Bottom Navbar) */}\n      <nav id=\"bottom-navbar\" className=\"lg:hidden fixed bottom-0 left-0 right-0 z-50 bg-zinc-950/95 border-t border-zinc-900 backdrop-blur-md px-3 py-2 flex items-center justify-around pb-safe\">\n        <button\n          onClick={() => setActiveTab(\'home\')}\n          className={`flex flex-col items-center gap-1 p-1 transition-all cursor-pointer ${\n            activeTab === \'home\' ? \'text-indigo-400 font-bold\' : \'text-zinc-500\'\n          }`}\n        >\n          <LayoutDashboard className=\"w-5 h-5\" />\n          <span className=\"text-[9px]\">In\303\255cio</span>\n        </button>\n        <button\n          onClick={() => setActiveTab(\'rebalance\')}\n          className={`flex flex-col items-center gap-1 p-1 transition-all cursor-pointer ${\n            activeTab === \'rebalance\' ? \'text-indigo-400 font-bold\' : \'text-zinc-500\'\n          }`}\n        >\n          <Scale className=\"w-5 h-5\" />\n          <span className=\"text-[9px]\">Sugest\303\243o</span>\n        </button>\n        <button\n          onClick={() => setActiveTab(\'contributions\')}\n          className={`flex flex-col items-center gap-1 p-1 transition-all cursor-pointer ${\n            activeTab === \'contributions\' ? \'text-indigo-400 font-bold\' : \'text-zinc-500\'\n          }`}\n        >\n          <Coins className=\"w-5 h-5\" />\n          <span className=\"text-[9px]\">Aportes</span>\n        </button>\n        <button\n          onClick={() => setActiveTab(\'portfolio\')}\n          className={`flex flex-col items-center gap-1 p-1 transition-all cursor-pointer ${\n            activeTab === \'portfolio\' ? \'text-indigo-400 font-bold\' : \'text-zinc-500\'\n          }`}\n        >\n          <Briefcase className=\"w-5 h-5\" />\n          <span className=\"text-[9px]\">Carteira</span>\n        </button>\n        <button\n          onClick={() => setActiveTab(\'settings\')}\n          className={`flex flex-col items-center gap-1 p-1 transition-all cursor-pointer ${\n            activeTab === \'settings\' ? \'text-indigo-400 font-bold\' : \'text-zinc-500\'\n          }`}\n        >\n          <Settings className=\"w-5 h-5\" />\n          <span className=\"text-[9px]\">Ajustes</span>\n        </button>\n      </nav>\n\n      {/* Main Page Area */}\n      <div className=\"flex-1 flex flex-col min-h-screen pb-24 lg:pb-0 overflow-x-hidden\">\n        \n        {/* Barra Superior para Mobile */}\n        <header id=\"mobile-header\" className=\"lg:hidden bg-zinc-950 border-b border-zinc-900 px-4 py-3.5 flex items-center justify-between sticky top-0 z-30\">\n          <div className=\"flex items-center gap-2\">\n            <Landmark className=\"w-5 h-5 text-indigo-400\" />\n            <span className=\"text-sm font-bold text-zinc-100 tracking-tight font-sans\">\n              Predictive Engine\n            </span>\n          </div>\n          <div className=\"flex items-center gap-2\">\n            <button\n              onClick={handleRefreshQuotes}\n              disabled={isLoadingQuotes || assets.length === 0}\n              className=\"p-2 bg-zinc-900 border border-zinc-800 rounded-lg text-zinc-400 hover:text-zinc-200 transition-colors disabled:opacity-40 cursor-pointer flex items-center\"\n              title=\"Atualizar cota\303\247\303\265es\"\n            >\n              <RefreshCw className={`w-3.5 h-3.5 ${isLoadingQuotes ? \'animate-spin text-indigo-400\' : \'\'}`} />\n            </button>\n          </div>\n        </header>\n\n        {isLoading ? (\n          <div className=\"flex-1 flex flex-col items-center justify-center py-20 text-zinc-500 gap-2\">\n            <RefreshCw className=\"w-8 h-8 animate-spin text-indigo-500\" />\n            <p className=\"text-xs font-mono\">Carregando carteira de investimentos...</p>\n          </div>\n        ) : (\n          <div className=\"flex-1 p-4 sm:p-6 md:p-8 max-w-7xl w-full mx-auto space-y-6\">\n            \n            {/* TAB 1: IN\303\215CIO (DASHBOARD & PATRIM\303\224NIO) */}\n            {activeTab === \'home\' && (\n              <div className=\"space-y-6\">\n                {/* Premium Strategy Header */}\n                <Header\n                  assets={assets}\n                  allocations={allocations}\n                  usdToBrlRate={usdToBrlRate}\n                />\n\n                {/* Database Connection Status Banner */}\n                <div className=\"p-4 rounded-xl border flex flex-col md:flex-row md:items-start justify-between gap-4 text-xs bg-zinc-900/20 border-zinc-800/80\">\n                  <div className=\"flex items-start gap-2.5 flex-1\">\n                    <Cloud className=\"w-4 h-4 shrink-0 mt-0.5 text-indigo-400\" />\n                    <div className=\"flex-1\">\n                      <div className=\"flex items-center gap-3 flex-wrap\">\n                        <span className=\"font-semibold block text-zinc-200\">\n                          {user ? \'Backup em Nuvem Ativo\' : \'Modo de Armazenamento Local (Offline-first)\'}\n                        </span>\n                        {user ? (\n                          <button onClick={handleLogout} className=\"flex items-center gap-1 px-2 py-0.5 bg-zinc-900 border border-zinc-800 rounded-md text-[10px] hover:bg-zinc-850 transition-colors cursor-pointer\">\n                            <LogOut className=\"w-3 h-3\" /> Desconectar\n                          </button>\n                        ) : (\n                          <button onClick={handleLogin} disabled={isLoggingIn} className=\"flex items-center gap-1 px-2.5 py-0.5 bg-white text-black font-semibold rounded-md hover:bg-zinc-200 transition-colors cursor-pointer text-[10px]\">\n                            {isLoggingIn ? \'Conectando...\' : \'Conectar com Google\'}\n                          </button>\n                        )}\n                      </div>\n                      <p className=\"text-[10px] text-zinc-500 mt-1 leading-relaxed max-w-lg\">\n                        {user \n                          ? `Sincronizado com ${user.email}. Seus dados est\303\243o protegidos e salvos no seu Google Drive pessoal.` \n                          : \'Seus dados s\303\243o salvos localmente neste navegador. Fa\303\247a login com o Google para ativar backups autom\303\241ticos na nuvem.\'}\n                      </p>\n\n                      {/* Sync Status Overlay */}\n                      {syncStatus.status !== \'idle\' && (\n                        <div className={`mt-2 text-[10px] flex items-center gap-1.5 px-2.5 py-1 rounded-lg border w-fit ${\n                          syncStatus.status === \'syncing\' ? \'bg-zinc-900 border-zinc-800 text-zinc-400\' :\n                          syncStatus.status === \'success\' ? \'bg-emerald-950/60 border-emerald-900/40 text-emerald-300\' :\n                          \'bg-red-950/60 border-red-900/40 text-red-300\'\n                        }`}>\n                          <div className={`w-1.5 h-1.5 rounded-full ${\n                            syncStatus.status === \'syncing\' ? \'bg-zinc-400 animate-pulse\' :\n                            syncStatus.status === \'success\' ? \'bg-emerald-400\' :\n                            \'bg-red-400\'\n                          }`} />\n                          <span className=\"font-mono\">\n                            {syncStatus.status === \'syncing\' && \'Sincronizando...\'}\n                            {syncStatus.status === \'success\' && (syncStatus.message || \'Sincronizado com sucesso!\')}\n                            {syncStatus.status === \'error\' && (syncStatus.message || \'Erro de sincroniza\303\247\303\243o.\')}\n                          </span>\n                        </div>\n                      )}\n                    </div>\n                  </div>\n                  \n                  {user && (\n                    <div className=\"flex flex-row items-center gap-2 self-start md:self-auto\">\n                      <button onClick={handleSyncToDrive} className=\"px-3 py-1 bg-indigo-600 hover:bg-indigo-500 text-white border border-indigo-500 rounded-lg transition-colors font-semibold text-[11px] cursor-pointer\">\n                        Fazer Backup\n                      </button>\n                      <button onClick={handleSyncFromDrive} className=\"px-3 py-1 bg-zinc-900 text-zinc-300 border border-zinc-800 rounded-lg hover:bg-zinc-800 transition-colors font-semibold text-[11px] cursor-pointer\">\n                        Restaurar\n                      </button>\n                    </div>\n                  )}\n\n                  {/* Market Quotes Updater (Desktop layout within Banner) */}\n                  <div className=\"hidden md:flex items-center gap-3 shrink-0 border-l border-zinc-800 pl-4\">\n                    <button\n                      onClick={handleRefreshQuotes}\n                      disabled={isLoadingQuotes || assets.length === 0}\n                      className=\"bg-zinc-900 hover:bg-zinc-850 disabled:opacity-40 text-zinc-200 border border-zinc-800 rounded-lg px-3 py-1.5 flex items-center gap-2 transition-all font-semibold cursor-pointer text-[11px]\"\n                    >\n                      <RefreshCw className={`w-3.5 h-3.5 ${isLoadingQuotes ? \'animate-spin text-indigo-400\' : \'\'}`} />\n                      Atualizar Cota\303\247\303\265es\n                    </button>\n                  </div>\n                </div>\n\n                {/* Portfolio Charts Visualizations */}\n                <div className=\"w-full\">\n                  <PortfolioCharts\n                    assets={assets}\n                    allocations={allocations}\n                    usdToBrlRate={usdToBrlRate}\n                    rebalanceResult={rebalanceResult}\n                  />\n                </div>\n              </div>\n            )}\n\n            {/* TAB 2: SUGEST\303\203O DE COMPRA (MATH ENGINE) */}\n            {activeTab === \'rebalance\' && (\n              <div className=\"space-y-6\">\n                <div>\n                  <h2 className=\"text-xl font-bold text-zinc-100 tracking-tight font-sans\">\n                    Sugest\303\243o de Compra & Rebalanceamento\n                  </h2>\n                  <p className=\"text-xs text-zinc-400 mt-1\">\n                    Defina o valor dispon\303\255vel para investir e deixe que o algoritmo de mochila (Knapsack) indique exatamente quanto e em quais ativos alocar os recursos para aproximar seu portf\303\263lio dos pesos alvo estabelecidos.\n                  </p>\n                </div>\n\n                <div className=\"max-w-4xl\">\n                  <RebalanceEngine\n                    assets={assets}\n                    allocations={allocations}\n                    onCalculationTrigger={setRebalanceResult}\n                    rebalanceResult={rebalanceResult}\n                    usdToBrlRate={usdToBrlRate}\n                  />\n                </div>\n              </div>\n            )}\n\n            {/* TAB 3: LAN\303\207AR APORTES (HISTORY RECORDER) */}\n            {activeTab === \'contributions\' && (\n              <div className=\"space-y-6\">\n                <div>\n                  <h2 className=\"text-xl font-bold text-zinc-100 tracking-tight font-sans\">\n                    Lan\303\247ar Aportes & Hist\303\263rico\n                  </h2>\n                  <p className=\"text-xs text-zinc-400 mt-1\">\n                    Registre os dep\303\263sitos realizados em seu hist\303\263rico pessoal de investimentos. Voc\303\252 pode definir os valores manualmente ou calcular as estimativas com base no patrim\303\264nio acumulado da sua carteira em cada per\303\255odo.\n                  </p>\n                </div>\n\n                <ContributionLogger\n                  assets={assets}\n                  usdToBrlRate={usdToBrlRate}\n                />\n              </div>\n            )}\n\n            {/* TAB 4: CARTEIRA (ASSETS LIST & IMPORT) */}\n            {activeTab === \'portfolio\' && (\n              <div className=\"space-y-6\">\n                <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n                  <div>\n                    <h2 className=\"text-xl font-bold text-zinc-100 tracking-tight font-sans\">\n                      Composi\303\247\303\243o da Carteira\n                    </h2>\n                    <p className=\"text-xs text-zinc-400 mt-1\">\n                      Cadastre, altere a nota de relev\303\242ncia de cada ativo ou gerencie os bloqueios na quarentena. Voc\303\252 tamb\303\251m pode colar as cota\303\247\303\265es diretamente do seu broker para carregar novos ativos.\n                    </p>\n                  </div>\n                  \n                  <button\n                    onClick={handleRefreshQuotes}\n                    disabled={isLoadingQuotes || assets.length === 0}\n                    className=\"bg-zinc-900 hover:bg-zinc-800 disabled:opacity-40 text-zinc-200 border border-zinc-800 rounded-lg px-4 py-2 flex items-center justify-center gap-2 transition-all font-semibold cursor-pointer text-xs self-start sm:self-auto\"\n                  >\n                    <RefreshCw className={`w-3.5 h-3.5 ${isLoadingQuotes ? \'animate-spin text-indigo-400\' : \'\'}`} />\n                    For\303\247ar Recarga de Pre\303\247os\n                  </button>\n                </div>\n\n                <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-start\">\n                  {/* Inventory List (Col Span 8) */}\n                  <div className=\"lg:col-span-8\">\n                    <AssetList\n                      assets={assets}\n                      onToggleQuarantine={handleToggleQuarantine}\n                      onUpdateScore={handleUpdateScore}\n                      onAddAsset={handleAddAsset}\n                      onDeleteAsset={handleDeleteAsset}\n                      categories={allocations.map(a => a.category)}\n                      usdToBrlRate={usdToBrlRate}\n                      isLoadingQuotes={isLoadingQuotes}\n                    />\n                  </div>\n\n                  {/* Broker Text Importer (Col Span 4) */}\n                  <div className=\"lg:col-span-4 space-y-6\">\n                    <DataImporter\n                      onImportAssets={handleImportAssets}\n                      usdToBrlRate={usdToBrlRate}\n                    />\n                  </div>\n                </div>\n              </div>\n            )}\n\n            {/* TAB 5: CONFIGURA\303\207\303\225ES (PARAMETERS & TARGETS) */}\n            {activeTab === \'settings\' && (\n              <div className=\"space-y-6\">\n                <div>\n                  <h2 className=\"text-xl font-bold text-zinc-100 tracking-tight font-sans\">\n                    Par\303\242metros & Ajustes do Sistema\n                  </h2>\n                  <p className=\"text-xs text-zinc-400 mt-1\">\n                    Gerencie as aloca\303\247\303\265es ideais do portf\303\263lio, configure as prefer\303\252ncias de arredondamento de cota\303\247\303\265es para cada categoria e fa\303\247a backup dos dados.\n                  </p>\n                </div>\n\n                <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-start\">\n                  {/* Targets & Decimal places (Col Span 7) */}\n                  <div className=\"lg:col-span-7\">\n                    <SettingsPanel\n                      allocations={allocations}\n                      onUpdateAllocations={handleUpdateAllocations}\n                      usdToBrlRate={usdToBrlRate}\n                      onUpdateUsdRate={handleUpdateUsdRate}\n                      availableCategories={availableCategories}\n                    />\n                  </div>\n\n                  {/* Sync drive & utilities (Col Span 5) */}\n                  <div className=\"lg:col-span-5 space-y-6\">\n                    \n                    {/* Cloud Storage integration panel */}\n                    <div className=\"bg-zinc-900 border border-zinc-800 rounded-xl p-5 shadow-xl space-y-4\">\n                      <h3 className=\"text-sm font-bold uppercase tracking-wider text-zinc-300 border-b border-zinc-800 pb-2\">\n                        Integra\303\247\303\243o Google Drive\n                      </h3>\n                      <p className=\"text-xs text-zinc-400 leading-relaxed\">\n                        Sua carteira pode ser sincronizada de forma segura com sua conta Google. Backups criptografados s\303\243o salvos diretamente no seu espa\303\247o privado do Drive (App Data Folder).\n                      </p>\n                      \n                      <div className=\"pt-2 flex flex-col gap-3\">\n                        {user ? (\n                          <div className=\"space-y-3\">\n                            <div className=\"flex items-center justify-between text-xs font-mono bg-zinc-950 p-3 rounded-lg border border-zinc-850\">\n                              <span className=\"text-zinc-500\">Logado:</span>\n                              <span className=\"text-zinc-200 font-semibold\">{user.email}</span>\n                            </div>\n                            <div className=\"flex gap-2\">\n                              <button onClick={handleSyncToDrive} className=\"flex-1 px-3 py-2 bg-indigo-600 hover:bg-indigo-500 text-white rounded-lg transition-colors font-semibold text-xs cursor-pointer text-center\">\n                                Salvar Backup Now\n                              </button>\n                              <button onClick={handleSyncFromDrive} className=\"flex-1 px-3 py-2 bg-zinc-800 text-zinc-300 rounded-lg hover:bg-zinc-700 transition-colors font-semibold text-xs cursor-pointer text-center\">\n                                Restaurar do Drive\n                              </button>\n                            </div>\n                            <button onClick={handleLogout} className=\"w-full text-center text-xs text-red-400 hover:text-red-300 font-semibold py-1.5 transition-colors cursor-pointer\">\n                              Desconectar Conta Google\n                            </button>\n                          </div>\n                        ) : (\n                          <button\n                            onClick={handleLogin}\n                            disabled={isLoggingIn}\n                            className=\"w-full bg-white text-black font-semibold py-2.5 rounded-lg hover:bg-zinc-200 transition-colors text-xs cursor-pointer flex items-center justify-center gap-2\"\n                          >\n                            <Cloud className=\"w-4 h-4 text-black\" />\n                            {isLoggingIn ? \'Conectando ao Drive...\' : \'Conectar com Conta Google\'}\n                          </button>\n                        )}\n                      </div>\n                    </div>\n\n                    {/* Reset Data utility card */}\n                    <div className=\"bg-zinc-900 border border-zinc-800 rounded-xl p-5 shadow-xl space-y-4\">\n                      <div>\n                        <span className=\"font-semibold text-zinc-300 block text-xs uppercase tracking-wider\">Modo de Teste / Redefini\303\247\303\243o</span>\n                        <span className=\"text-[10px] text-zinc-500 leading-relaxed block mt-1\">\n                          Restaure instantaneamente a carteira para o estado demonstrativo padr\303\243o contendo ativos como WEGE3, VALE3, ITSA4, HGLG11 e AAPL.\n                        </span>\n                      </div>\n                      \n                      <div className=\"pt-2\">\n                        {confirmReset ? (\n                          <div className=\"flex items-center gap-2\">\n                            <button\n                              onClick={() => {\n                                handleResetDemoData();\n                                setConfirmReset(false);\n                              }}\n                              className=\"flex-1 bg-red-600 hover:bg-red-500 text-white border border-red-500 py-2 rounded-lg transition-all font-semibold text-xs cursor-pointer\"\n                            >\n                              Sim, apagar tudo e resetar\n                            </button>\n                            <button\n                              onClick={() => setConfirmReset(false)}\n                              className=\"flex-1 bg-zinc-800 hover:bg-zinc-700 text-zinc-300 py-2 rounded-lg transition-all font-semibold text-xs cursor-pointer\"\n                            >\n                              Cancelar\n                            </button>\n                          </div>\n                        ) : (\n                          <button\n                            onClick={() => setConfirmReset(true)}\n                            className=\"w-full bg-zinc-950 hover:bg-zinc-900 text-zinc-400 hover:text-zinc-200 border border-zinc-800 py-2 rounded-lg flex items-center justify-center gap-1.5 transition-all font-semibold cursor-pointer text-xs\"\n                          >\n                            <RotateCcw className=\"w-3.5 h-3.5\" />\n                            Resetar para Carteira Demonstrativa\n                          </button>\n                        )}\n                      </div>\n                    </div>\n\n                  </div>\n                </div>\n              </div>\n            )}\n\n          </div>\n        )}\n\n        {/* Footer */}\n        <footer className=\"bg-zinc-950 border-t border-zinc-900 py-6 text-center text-[10px] text-zinc-500 font-mono\">\n          PREDICTIVE REBALANCING ENGINE &bull; POWERED BY YAHOO FINANCE CODES &bull; BUY & HOLD INTENT\n        </footer>\n\n      </div>\n    </div>\n  );\n}"
      }
      num_matches: 1
    }
  }
}
