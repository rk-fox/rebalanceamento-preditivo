        }
        lines {
          text: "    const nativeVal = asset.invested_amount || 0;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    return asset.currency === \'USD\' ? nativeVal * usdToBrlRate : nativeVal;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  };"
